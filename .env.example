# ============================================================
# App
# ============================================================
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=https://tufrontend.com,https://admin.tufrontend.com
# SWAGGER_ENABLED=true   # En produccion Swagger esta OFF por defecto; ponlo en 'true' para exponerlo
# LOG_LEVEL=log,warn,error  # Niveles de log (default: debug en dev, log en prod)

# ============================================================
# Base de datos
# ============================================================
DATABASE_URL=postgresql://user:password@localhost:5432/biker_os
# DATABASE_SSL=true     # Requerido para RDS/Neon/Supabase (managed Postgres)
# DATABASE_POOL_MAX=20           # Max conexiones del pool (default 20)
# DATABASE_STATEMENT_TIMEOUT_MS=30000  # Timeout por query en ms (default: sin limit)
# DATABASE_QUERY_TIMEOUT_MS=30000       # Timeout cliente-side en ms (default: sin limit)

# ============================================================
# Redis
# ============================================================
REDIS_URL=redis://localhost:6379

# ============================================================
# JWT
# ============================================================
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_SECRET=your-refresh-secret-min-32-chars
REFRESH_EXPIRES_IN=7d

# ============================================================
# Wompi (Colombia)
# Sandbox: https://sandbox.wompi.co/v1
# Production: https://production.wompi.co/v1
# ============================================================
WOMPI_PUBLIC_KEY=pub_test_...
WOMPI_PRIVATE_KEY=prv_test_...
WOMPI_INTEGRITY_KEY=test_integrity_...   # OBLIGATORIA: firma de integridad SHA256 para transacciones con token/fuente guardada
WOMPI_EVENTS_SECRET=whsec_...
WOMPI_BASE_URL=https://sandbox.wompi.co/v1

# Modo dry-run: simula pagos Wompi y omite las llaves WOMPI_*/ALEGRA_*
# en validateEnv. Util para desarrollo local y tests e2e sin red.
# true | false (default)
# BILLING_DRY_RUN=true
# CRON_BATCH_SIZE=200  # Limite de items por ejecucion de cron (default 200)

# ============================================================
# Alegra (Facturacion electronica DIAN)
# ============================================================
ALEGRA_EMAIL=tu-email@alegra.com
ALEGRA_API_KEY=tu-api-key
ALEGRA_BASE_URL=https://app.alegra.com/api/v1

# ============================================================
# Cloudflare Turnstile (login web)
# Deja vacio en desarrollo para omitir validacion; en produccion se requiere.
# ============================================================
TURNSTILE_SECRET_KEY=

# ============================================================
# Firebase / FCM
# FcmService usa estas 3 variables. NO usar FIREBASE_SERVICE_ACCOUNT
# (JSON completo): no se lee en ningún lado y queda huérfana en .env.
# ============================================================
FIREBASE_PROJECT_ID=...
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@[project].iam.gserviceaccount.com
